# Router kit Comms-Lobby-Only: the HLA Comms lobby only. Voice, text and images in the lobby pass
# between the HLA Comms federations; messages in every other channel are dropped, whether the
# gateway has seen the channel or not. Nothing is mirrored or registered: only the HLA Comms message
# interactions pass.
router.kind=comms
comms.mode=messages
comms.messages=audio;text;image
comms.channels=none
