# SimWeaver Junction - systemd service (Linux). The installation guide, 1b, has the details.
#
# The program (the unpacked zip) in /opt/simweaver/junction, a link to the version in use; the site
# (settings, logs, key store) in /var/lib/simweaver-junction; the user simweaver. As root:
#   useradd --system --home-dir /var/lib/simweaver-junction --shell /usr/sbin/nologin simweaver
#   cp /opt/simweaver/junction/deploy/systemd/simweaver-junction.default /etc/default/simweaver-junction
#   (set RTI_JAR in it), then:
#   cp /opt/simweaver/junction/deploy/systemd/simweaver-junction.service /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now simweaver-junction
# The first start makes the site from the program's etc.dist. systemd makes the site folder
# (StateDirectory) and gives it to the user.
#
# Then: systemctl status simweaver-junction / journalctl -u simweaver-junction -f
# After editing this file in /etc/systemd/system: systemctl daemon-reload && systemctl restart simweaver-junction

[Unit]
Description=SimWeaver Junction - HLA and DIS gateway, monitor and site link
Documentation=file:///opt/simweaver/junction/doc/simweaver-rift-install-and-config.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=simweaver
Group=simweaver
# the site folder: /var/lib/simweaver-junction, made by systemd and owned by the user
StateDirectory=simweaver-junction
StateDirectoryMode=0750
WorkingDirectory=/var/lib/simweaver-junction
# RTI_JAR, JAVA_OPTS, JAVA_HOME and JUNCTION_ARGS (more arguments); the RTI library is set there, so a
# new version of this file never loses it
EnvironmentFile=-/etc/default/simweaver-junction
EnvironmentFile=-/etc/sysconfig/simweaver-junction
ExecStart=/bin/sh /opt/simweaver/junction/run.sh --root=/var/lib/simweaver-junction $JUNCTION_ARGS
Restart=on-failure
RestartSec=5
# Java ends with 143 on SIGTERM, after the server has resigned and logged
SuccessExitStatus=143
TimeoutStopSec=30
LimitNOFILE=65536
UMask=0027

# Hardening: the whole system read-only except the site, no home folders, own /tmp. An RTI that
# writes files of its own outside the site needs that folder added to ReadWritePaths. No
# MemoryDenyWriteExecute (Java's JIT) and no SystemCallFilter (RTIs with native code).
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/simweaver-junction
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictRealtime=true
LockPersonality=true

# J2J's last resort on port 443 (installation guide, 2.8): remove the # of both lines
#AmbientCapabilities=CAP_NET_BIND_SERVICE
#CapabilityBoundingSet=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
