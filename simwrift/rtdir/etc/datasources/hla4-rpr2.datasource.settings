# Datasource HLA4-RPR2: an HLA 4 (IEEE 1516-2025) federation with the full RPR FOM v2.0, Link 16
# included, in one file in the HLA 4 format.
datasource.name=HLA4-RPR2
#
datasource.standard=ieee1516-2025
# HLA related - effective when using HLA
# semicolon separated list of files or directories.
# relative to the fomdir of the standard specified.
datasource.hla.foms=RPR_FOM_v2.0_Link16_1516-2025.xml
# or modules of the HLA 4 RPR v2, e.g. RPR-Base_v2.0.xml;RPR-Foundation_v2.0.xml;RPR-Enumerations_v2.0.xml;RPR-Switches_v2.0.xml
#
datasource.hla.lsd=MumboJumbo
datasource.hla.federation=test2
# datasource.hla.customfederatetype=SimwRift
# datasource.hla.reconnectondisconnect=true
# datasource.hla.reconnectintervalseconds=5
# datasource.hla.customfomrootdir=./etc/fom/ieee1516-2025