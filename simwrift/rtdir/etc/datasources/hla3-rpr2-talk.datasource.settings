# Datasource HLA3-RPR2-Talk: an HLA Evolved federation running the RPR FOM v2.0 (Link 16 included)
# and the Talk FOM. No Talk FOM is delivered with SimWeaver: the datasource takes the FOM from the
# running federation (dynamic), so the federation must be running. To use your own copy of the
# Talk FOM files instead, put them in etc/fom/ieee1516-2010 and list them:
# datasource.hla.foms=RPR_FOM_v2.0_Link16_1516-2010.xml;<your Talk FOM module>.xml;<another module>.xml
datasource.name=HLA3-RPR2-Talk
datasource.standard=ieee1516-2010
# HLA related - effective when using HLA
# semicolon separated list of files or directories.
# relative to the comdir of the standard specified.
datasource.hla.foms=dynamic
#
datasource.hla.lsd=default
datasource.hla.federation=Talk
# datasource.hla.customfederatetype=SimwRift
# datasource.hla.reconnectondisconnect=true
# datasource.hla.reconnectintervalseconds=5
# datasource.hla.customfomrootdir=./etc/fom/ieee1516-2010