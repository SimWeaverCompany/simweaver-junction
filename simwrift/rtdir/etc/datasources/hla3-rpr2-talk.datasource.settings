# Datasource HLA3-RPR2-Talk: an HLA Evolved federation with the RPR FOM v2.0 (Link 16 included)
# and the Pitch Talk FOM.
datasource.name=HLA3-RPR2-Talk
datasource.standard=ieee1516-2010
# HLA related - effective when using HLA
# semicolon separated list of files or directories.
# relative to the comdir of the standard specified.
datasource.hla.foms=RPR_FOM_v2.0_Link16_1516-2010.xml;pitchtalk.xml;pitchtalkeffects.xml
#
datasource.hla.lsd=default
datasource.hla.federation=PitchTalkDeafault
