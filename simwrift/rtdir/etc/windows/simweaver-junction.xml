<!--
  SimWeaver Junction as a Windows service, with WinSW (the Windows Service Wrapper, MIT licence,
  https://github.com/winsw/winsw - not part of SimWeaver; download it yourself).
  The installation guide, 1d, has the details. In short, in a command prompt run as administrator:

    1. Download WinSW-x64.exe (WinSW 2.12) and save it in the installation folder as
       simweaver-junction.exe
    2. Copy this file next to it:   copy etc\windows\simweaver-junction.xml simweaver-junction.xml
    3. Check the RTI path and the Java line below
    4. simweaver-junction.exe install
       simweaver-junction.exe start

  Then: Services (services.msc) shows "SimWeaver Junction"; simweaver-junction.exe status / stop /
  restart / uninstall. The server's own logs are in log\ (logdir) as usual; WinSW writes its
  console capture to log\service.
-->
<service>
  <id>simweaver-junction</id>
  <name>SimWeaver Junction</name>
  <description>SimWeaver Junction - HLA and DIS gateway, monitor and site link</description>

  <!-- Java 11 or later. "java" is taken from the system PATH (not your own user PATH); or give
       the full path, e.g. C:\Program Files\Eclipse Adoptium\jdk-17.0.12.7-hotspot\bin\java.exe -->
  <executable>java</executable>

  <!-- The class path: SimWeaver, then the HLA RTI's library (pRTI 6 here; remove ";..." for DIS
       only). Add Java options before -cp, e.g. -Xmx2g. Add etcdir=D:/SimWeaver/etc at the end to
       keep the configuration outside the installation folder. -->
  <arguments>-cp "%BASE%\lib\simweaverrift.jar;C:\Program Files\prti6\lib\prtifull.jar" com.simweaver.rift.Server</arguments>

  <!-- %BASE% is the folder of simweaver-junction.exe: the installation folder -->
  <workingdirectory>%BASE%</workingdirectory>

  <startmode>Automatic</startmode>

  <!-- Stopping: WinSW sends Ctrl+C, and the server resigns from its federations and sends the
       rest of its log; after this long it is ended. -->
  <stoptimeout>30 sec</stoptimeout>

  <!-- Restarting when it fails: after 10 s, then after 30 s; the count starts again after an hour -->
  <onfailure action="restart" delay="10 sec"/>
  <onfailure action="restart" delay="30 sec"/>
  <resetfailure>1 hour</resetfailure>

  <!-- WinSW's capture of the console (the server writes its own log files to logdir as well) -->
  <logpath>%BASE%\log\service</logpath>
  <log mode="roll-by-size">
    <sizeThreshold>10240</sizeThreshold>
    <keepFiles>5</keepFiles>
  </log>

  <!-- The account: LocalSystem unless you set one here, or later in Services, "Log On". The account
       needs to read the installation folder and write to log\ and etc\ (or etcdir).
  <serviceaccount>
    <domain>.</domain>
    <user>simweaver</user>
    <password>change-me</password>
    <allowservicelogon>true</allowservicelogon>
  </serviceaccount>
  -->
</service>
