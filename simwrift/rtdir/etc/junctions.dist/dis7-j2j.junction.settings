# Gateway DIS7<->J2J (0.10.0): a DIS 7 network shared, PDU by PDU, with gateways on other SimWeaver
# servers through a session of the J2J network. Start the same (or a DIS 6 / C-DIS) gateway on the
# other servers: they meet in the session named by endpoint.j2j.session (or the target at the start).
junction.name=DIS7<->J2J
junction.description=DIS 7 on port 3000 shared with the other members of a J2J session (DIS PDUs as they are)
junction.endpoints=dis;j2j
junction.endpoint.dis=endpoints/dis7.endpoint.settings
# where dis sends (default: the multicast group, else the broadcast address of the interface); several
# with ; between them, each host or host:port, e.g. 10.0.0.5;10.0.0.6:3001
# junction.endpoint.dis.dis.sendaddress=192.168.1.255
junction.endpoint.j2j=endpoints/j2j-pdu.endpoint.settings
junction.router=routers/pdu-relay.router.settings
junction.autostart=false
