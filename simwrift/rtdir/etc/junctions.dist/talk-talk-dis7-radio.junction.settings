# Gateway Talk<->Talk + DIS7 radio: two Talk federations, and two of their voice channels on
# DIS radio.
junction.name=Talk<->Talk + DIS7 radio
junction.endpoints=site1;site2;radio
junction.endpoint.site1=endpoints/talk.endpoint.settings
junction.endpoint.site1.hla.federation=TalkSite1
junction.endpoint.site2=endpoints/talk.endpoint.settings
junction.endpoint.site2.hla.federation=TalkSite2
junction.endpoint.radio=endpoints/dis7.endpoint.settings
# where radio sends (default: the multicast group, else the broadcast address of the interface); several
# with ; between them, each host or host:port, e.g. 10.0.0.5;10.0.0.6:3001
# junction.endpoint.radio.dis.sendaddress=192.168.1.255
junction.router=routers/talk-full.router.settings
# the radio bridge: Talk channel name = frequency in Hz, on this endpoint (DIS or an RPR federation)
junction.talk.radio.endpoint=radio
junction.talk.radio.map.Battalion=251000000
junction.talk.radio.map.Logistics=36500000
# the DIS entity that hosts the gateway's radios (one radio per Talk sender)
junction.talk.radio.entityid=900-99-1
# Talk audio: sample rate and byte order of PCM16 (to be confirmed against your Talk version)
junction.talk.audio.samplerate=16000
junction.talk.audio.pcmbyteorder=little
# sent as RPR: pcm16be (DIS "16-bit linear PCM"), pcm16le or mulaw, at this rate (0 = Talk's)
junction.talk.audio.rprencoding=pcm16be
junction.talk.audio.rprsamplerate=8000
# after the last Talk audio frame, the radio stays "transmitting" this long
junction.talk.radio.hangtimems=500
junction.autostart=false
