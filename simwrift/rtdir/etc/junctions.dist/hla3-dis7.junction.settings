# Gateway HLA3<->DIS7: an HLA Evolved RPR v2 federation and a DIS 7 network.
junction.name=HLA3<->DIS7
junction.description=RPR v2 federation (Link 16 included) bridged to DIS 7 on port 3000
junction.endpoints=hla;dis
junction.endpoint.hla=endpoints/hla3-rpr2.endpoint.settings
junction.endpoint.dis=endpoints/dis7.endpoint.settings
junction.router=routers/hla3-all.router.settings
junction.autostart=false
