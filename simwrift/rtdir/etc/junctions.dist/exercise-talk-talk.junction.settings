# Group sample (2 of 2): the exercise's Pitch Talk federation and a site's Talk federation; the
# site's "Net1" is the exercise channel named by GROUPVAR3 (talk.channelmap.<receiver>).
junction.name=Exercise: Talk<->Talk
junction.group=Exercise
junction.endpoints=exercise;site
junction.endpoint.exercise=endpoints/talk.endpoint.settings
junction.endpoint.exercise.hla.federation=GROUPVAR1-Talk
junction.endpoint.site=endpoints/talk.endpoint.settings
junction.endpoint.site.hla.federation=SiteTalk
junction.router=routers/talk-messages.router.settings
junction.talk.channelmap.exercise=Net1>GROUPVAR3
junction.groupvar.GROUPVAR3=Battalion
junction.groupvar.GROUPVAR3.desc=Talk channel for the site's Net1
