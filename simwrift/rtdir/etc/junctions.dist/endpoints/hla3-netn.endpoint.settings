# Endpoint kit HLA3-NETN: an HLA Evolved (IEEE 1516-2010) federation with the NETN-FOM v4 modules
# on top of the RPR FOM v2.0, on the RTI found on Rift's class path. Add or remove NETN modules to
# match the federation's FOM.
endpoint.name=HLA3-NETN
endpoint.standard=ieee1516-2010
# FOM modules: relative names are looked up in etc/fom/ieee1516-2010 (endpoint.hla.fomrootdir)
endpoint.hla.foms=RPR_FOM_v2.0_Link16_1516-2010.xml;netn4-hla3/NETN-BASE.xml;netn4-hla3/NETN-ENTITY.xml;netn4-hla3/NETN-ORG.xml;netn4-hla3/NETN-ETR.xml;netn4-hla3/NETN-MRM.xml
# local settings designator; several choices separated by ';' (the first is the default)
endpoint.hla.lsd=default
# the default target; the Start dialog lists the federations the RTI knows
endpoint.hla.federation=NETN
endpoint.hla.createfederation=true
