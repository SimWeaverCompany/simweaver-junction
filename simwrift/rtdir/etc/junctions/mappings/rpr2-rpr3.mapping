# ====================================================================== enumerators
# Enumerators match by name, then by value; v2 and v3 differ mostly in underscores, with equal
# values. Where the values moved:

# camouflage: v2 0 = uniform paint scheme (v3 has PaintScheme for that), then desert, winter, forest, generic
enum.CamouflageEnum32.1 = AppearanceCamouflageTypeEnum8.0
enum.CamouflageEnum32.2 = AppearanceCamouflageTypeEnum8.1
enum.CamouflageEnum32.3 = AppearanceCamouflageTypeEnum8.2
enum.CamouflageEnum32.4 = AppearanceCamouflageTypeEnum8.3
