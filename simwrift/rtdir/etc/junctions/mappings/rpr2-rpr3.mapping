# SimWeaver Junction - RPR FOM v2.0 <-> v3.0 conversion rules
#
# One file for both directions: RPR v2.0 names on the left, RPR v3.0 names on the right.
# Without a rule, classes, members, record fields and enumerators keep their names;
# enumerators are matched by name, then by value. Junction reads the file again when it changes.
#
#   class.<v2 class>                 = <v3 class>       both ways (several v2 classes on one v3
#                                                        class: the last line gives the way back)
#   classup.<v2 class>               = <v3 class>       v2 -> v3 only
#   classdown.<v3 class>             = <v2 class>       v3 -> v2 only
#   attribute.<v2 class>.<attribute> = <v3 attribute>     on that class and its subclasses
#   parameter.<v2 class>.<parameter> = <v3 parameter>     on that class and its subclasses
#   field.<v2 record>.<field>        = <v3 record>.<field>
#   default.<v3 record>.<field>      =                     v3 field without a v2 source: default, no warning
#   default2.<v2 record>.<field>     =                     v2 field without a v3 source: default, no warning
#   enum.<v2 enum>.<value>           = <v3 enum>.<value>   one value, when names and values differ
#
# A rule on a subclass wins over one on its superclass (e.g. Lifeform.DamageState = Health
# next to PhysicalEntity.DamageState = Damage). Review with:
#   java -cp out/classes:out/test com.simweaver.junction.router.RprMappingLint <fom root> <this folder>

# ====================================================================== classes

# v3 put WeaponFire and MunitionDetonation under new base classes
class.HLAinteractionRoot.WeaponFire = HLAinteractionRoot.Fire.WeaponFire
class.HLAinteractionRoot.MunitionDetonation = HLAinteractionRoot.Detonation.MunitionDetonation
# v3 only: expendables and explosions are WeaponFire / MunitionDetonation in v2 (as DIS 6 sends them)
classdown.HLAinteractionRoot.Fire = HLAinteractionRoot.WeaponFire
classdown.HLAinteractionRoot.Fire.ExpendableFire = HLAinteractionRoot.WeaponFire
classdown.HLAinteractionRoot.Detonation = HLAinteractionRoot.MunitionDetonation
classdown.HLAinteractionRoot.Detonation.ExpendableBurst = HLAinteractionRoot.MunitionDetonation
classdown.HLAinteractionRoot.Detonation.Explosion = HLAinteractionRoot.MunitionDetonation
class.HLAinteractionRoot.TransferControl = HLAinteractionRoot.TransferOwnership

# IFF: v3 has one IFFSystem class with Interrogator / Transponder (the modes moved to IFFData)
classup.HLAobjectRoot.EmbeddedSystem.IFF.NatoIFF = HLAobjectRoot.EmbeddedSystem.IFFSystem
classup.HLAobjectRoot.EmbeddedSystem.IFF.SovietIFF = HLAobjectRoot.EmbeddedSystem.IFFSystem
classup.HLAobjectRoot.EmbeddedSystem.IFF.RRB = HLAobjectRoot.EmbeddedSystem.IFFSystem
classup.HLAobjectRoot.EmbeddedSystem.IFF.SovietIFF.SovietIFFTransponder = HLAobjectRoot.EmbeddedSystem.IFFSystem.Transponder
classup.HLAobjectRoot.EmbeddedSystem.IFF.SovietIFF.SovietIFFInterrogator = HLAobjectRoot.EmbeddedSystem.IFFSystem.Interrogator
class.HLAobjectRoot.EmbeddedSystem.IFF = HLAobjectRoot.EmbeddedSystem.IFFSystem
class.HLAobjectRoot.EmbeddedSystem.IFF.NatoIFF.NatoIFFTransponder = HLAobjectRoot.EmbeddedSystem.IFFSystem.Transponder
class.HLAobjectRoot.EmbeddedSystem.IFF.NatoIFF.NatoIFFInterrogator = HLAobjectRoot.EmbeddedSystem.IFFSystem.Interrogator
attribute.HLAobjectRoot.EmbeddedSystem.IFF.Layer2DataAvailable = EmissionsDataAvailable
attribute.HLAobjectRoot.EmbeddedSystem.IFF.SystemIsOperational = OperationalStatus
enum.RPRboolean.1 = OperationalStatusEnum8.0
enum.RPRboolean.0 = OperationalStatusEnum8.1
field.FundamentalParameterDataStruct.ERP = FundamentalParameterDataStruct.EIRP
default.FundamentalParameterDataStruct.SystemSpecificData =
default2.FundamentalParameterDataStruct.Padding =
# the IFF modes (v2 attributes, v3 IFFData objects) are converted in code: RprIffBridge

