# Endpoint kit: a Pitch Talk federation (pitchtalk.xml and pitchtalkeffects.xml from
# etc/fom/ieee1516-2010 are the default FOM modules).
endpoint.name=ASIM-EXT-Comms
endpoint.standard=talk
endpoint.hla.federation=GROUPVAR2-COMMS
# local settings designator, as for Rift datasources ("default" or vendor text, e.g. crcAddress=host:8989)
endpoint.hla.lsd=default
